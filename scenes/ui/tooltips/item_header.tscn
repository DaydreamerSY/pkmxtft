[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme/ui_theme.tres" id="1_ui_theme"]
[ext_resource type="Script" path="res://src/ui/tooltips/item_header.gd" id="2_item_header"]

[node name="ItemHeader" type="HBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 10
theme = ExtResource("1_ui_theme")
script = ExtResource("2_item_header")

[node name="Icon" type="TextureRect" parent="."]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(44, 44)
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Titles" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Titles"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"TitleLabel"
text = "Item"

[node name="Stats" type="RichTextLabel" parent="Titles"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 15
theme_override_font_sizes/bold_font_size = 15
theme_override_font_sizes/italics_font_size = 15
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3
