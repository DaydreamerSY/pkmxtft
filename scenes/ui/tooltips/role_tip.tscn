[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme/ui_theme.tres" id="1_ui_theme"]
[ext_resource type="Script" path="res://src/ui/tooltips/role_tip.gd" id="2_role_tip"]

[node name="RoleTip" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 6
theme = ExtResource("1_ui_theme")
script = ExtResource("2_role_tip")

[node name="Name" type="Label" parent="."]
layout_mode = 2
unique_name_in_owner = true
theme_override_font_sizes/font_size = 19
text = "Role"

[node name="Desc" type="RichTextLabel" parent="."]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 15
theme_override_font_sizes/bold_font_size = 15
theme_override_font_sizes/italics_font_size = 15
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3

[node name="Position" type="RichTextLabel" parent="."]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 14
theme_override_font_sizes/italics_font_size = 14
bbcode_enabled = true
fit_content = true
scroll_active = false
autowrap_mode = 3

[node name="ItemsLabel" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 14
text = "Suggested items"

[node name="Grid" type="GridContainer" parent="."]
layout_mode = 2
unique_name_in_owner = true
mouse_filter = 2
columns = 4
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 8
