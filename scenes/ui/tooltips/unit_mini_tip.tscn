[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme/ui_theme.tres" id="1_ui_theme"]
[ext_resource type="Script" path="res://src/ui/tooltips/unit_mini_tip.gd" id="2_unit_mini_ti"]
[ext_resource type="Texture2D" path="res://assets/icons/money.svg" id="3_money"]

[node name="UnitMiniTip" type="VBoxContainer"]
mouse_filter = 2
theme_override_constants/separation = 4
theme = ExtResource("1_ui_theme")
script = ExtResource("2_unit_mini_ti")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Header"]
layout_mode = 2
unique_name_in_owner = true
theme_override_font_sizes/font_size = 17
text = "Pokémon"

[node name="CostIcon" type="TextureRect" parent="Header"]
layout_mode = 2
custom_minimum_size = Vector2(16, 16)
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
texture = ExtResource("3_money")

[node name="Cost" type="Label" parent="Header"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"GoldLabel"
theme_override_font_sizes/font_size = 15
text = "1"

[node name="Types" type="VBoxContainer" parent="."]
layout_mode = 2
unique_name_in_owner = true
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Role" type="Label" parent="."]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 13
text = "Role"
